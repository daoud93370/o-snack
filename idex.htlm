<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>O'SNACK - Le Goût qui Rassemble</title>
  <style>
    :root {
      --bg-color: #0f0f0f;
      --card-bg: #1a1a1a;
      --accent-gold: #e5a93c;
      --text-color: #ffffff;
      --text-sub: #b0b0b0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
    }

    header {
      background-color: #000;
      padding: 15px 20px;
      text-align: center;
      border-bottom: 2px solid var(--accent-gold);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    header h1 {
      color: var(--accent-gold);
      font-size: 24px;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    header p {
      color: var(--text-sub);
      font-size: 13px;
    }

    .hero {
      text-align: center;
      padding: 30px 20px;
      background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.85)), url('https://i.ibb.co/G4wVCjDm/pic-93c1f81a-2e2e-4f4b-9d92-cafb7814bd92.jpg') center/cover;
    }

    .hero img {
      max-width: 280px;
      width: 100%;
      height: auto;
      margin-bottom: 15px;
      border-radius: 8px;
    }

    .hero h2 {
      color: var(--accent-gold);
      font-size: 26px;
      margin-bottom: 10px;
    }

    .hero p {
      color: #fff;
      font-size: 15px;
      margin-bottom: 20px;
    }

    .btn-wa {
      display: inline-block;
      background-color: #25D366;
      color: white;
      padding: 12px 25px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 25px;
      font-size: 16px;
    }

    .container {
      max-width: 10
